        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler date time creation">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.text.SimpleDateFormat
import java.util.concurrent.ThreadLocalRandom

// ---- User vars you can use in samplers ----
// ${created_0_value_date}               -&gt; e.g., 2025-09-26
// ${created_0_value_time}               -&gt; e.g., 084318
// ${created_0_value_time_colons}        -&gt; e.g., 08:43:18
// ${created_0_value_date_time}          -&gt; e.g., 2025-09-26_084318
// ${created_0_value_date_time_colons}   -&gt; e.g., 2025-09-26 08:43:18
//
// ${random_text}                        -&gt; e.g., mavqjsa
// ${random_text_time}                   -&gt; e.g., mavqjsa084318
// ${random_text_time_colons}            -&gt; e.g., mavqjsa08:43:18
// ${random_text_date}                   -&gt; e.g., mavqjsa2025-09-26
// ${random_text_date_time}              -&gt; e.g., mavqjsa2025-09-26_084318
// ${random_text_date_time_colons}       -&gt; e.g., mavqjsa2025-09-26 08:43:18

// ---------- config ----------
final String TZ_ID = &quot;Asia/Kolkata&quot;     // force IST regardless of machine TZ
final int RANDOM_MIN_LEN = 6            // random word length range
final int RANDOM_MAX_LEN = 10

// ---------- helpers ----------
def timeZone = java.util.TimeZone.getTimeZone(TZ_ID)

def dateFmt = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;)
dateFmt.setTimeZone(timeZone)

def timeFmt = new SimpleDateFormat(&quot;HHmmss&quot;)          // -&gt; 084318
timeFmt.setTimeZone(timeZone)

def timeFmtColons = new SimpleDateFormat(&quot;HH:mm:ss&quot;)  // -&gt; 08:43:18
timeFmtColons.setTimeZone(timeZone)

String randomWord(int minLen, int maxLen) {
    def letters = &quot;abcdefghijklmnopqrstuvwxyz&quot;
    int len = ThreadLocalRandom.current().nextInt(minLen, maxLen + 1)
    def sb = new StringBuilder(len)
    for (int i = 0; i &lt; len; i++) {
        int idx = ThreadLocalRandom.current().nextInt(letters.length())
        sb.append(letters.charAt(idx))
    }
    return sb.toString()
}

// ---------- now &amp; formats ----------
def now = new Date()
def createdDate = dateFmt.format(now)             // e.g., 2025-09-26
def createdTime = timeFmt.format(now)             // e.g., 084318
def createdTimeColons = timeFmtColons.format(now) // e.g., 08:43:18

// ---------- random text ----------
def randText = randomWord(RANDOM_MIN_LEN, RANDOM_MAX_LEN)     // e.g., &quot;mavqjsa&quot;
def randTextPlusTime = randText + createdTime                 // e.g., &quot;mavqjsa084318&quot;
def randTextPlusTimeColons = randText + createdTimeColons     // e.g., &quot;mavqjsa08:43:18&quot;

// ---------- extra composites ----------
def createdDateTime = &quot;${createdDate}_${createdTime}&quot;               // 2025-09-26_084318
def createdDateTimeColons = &quot;${createdDate} ${createdTimeColons}&quot;   // 2025-09-26 08:43:18

def randTextDate = &quot;${randText}${createdDate}&quot;                      // mavqjsa2025-09-26
def randTextDateTime = &quot;${randText}${createdDate}_${createdTime}&quot;   // mavqjsa2025-09-26_084318
def randTextDateTimeColons = &quot;${randText}${createdDate} ${createdTimeColons}&quot; // mavqjsa2025-09-26 08:43:18

// ---------- export as JMeter variables ----------
vars.put(&quot;created_0_value_date&quot;, createdDate)
vars.put(&quot;created_0_value_time&quot;, createdTime)
vars.put(&quot;created_0_value_time_colons&quot;, createdTimeColons)
vars.put(&quot;created_0_value_date_time&quot;, createdDateTime)
vars.put(&quot;created_0_value_date_time_colons&quot;, createdDateTimeColons)

vars.put(&quot;random_text&quot;, randText)
vars.put(&quot;random_text_time&quot;, randTextPlusTime)
vars.put(&quot;random_text_time_colons&quot;, randTextPlusTimeColons)
vars.put(&quot;random_text_date&quot;, randTextDate)
vars.put(&quot;random_text_date_time&quot;, randTextDateTime)
vars.put(&quot;random_text_date_time_colons&quot;, randTextDateTimeColons)

// (optional) quick log to JMeter console
log.info(&quot;IST date=${createdDate} time=${createdTime}(${createdTimeColons}) random=${randText}&quot;)
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
